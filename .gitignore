# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Bundled third-party BINARIES are not committed — install them yourself
# (only the pure-Python tools/jbig2topdf.py wrapper is kept in the repo)
*.exe
tools/jbig2/

# Work artifacts
*.part
*.log

# Test outputs (the settings-matrix sweep). Fixtures ARE committed.
tests/reports/
.pytest_cache/

# Run reports written to the tool folder (e.g. --in-place mode)
/reports/

# Run reports, wherever --log puts them. `reports/` is already ignored, but a bare
# --log writes to the CURRENT folder, so running from the repo root would otherwise
# show every report as untracked noise in `git status`.
_ocrmyworkshopmanual_report_*
